# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Flight logs stay local (private data). See samples/README.md.
/samples/*
!/samples/README.md
# Derived from the logs; regenerate with prototype/export_data.py
/prototype/data.js
# Copied from node_modules by cli/copy-maplibre-worker.ts
/public/maplibre/

# Python bytecode
__pycache__/
*.pyc

# Private notes, never committed
docs/outreach.md
docs/seo-plan.md
docs/competitive-analysis-log-explorer.md

# generated from prototype/dry-run.html by cli/make-debug-page.ts
/public/debug.html
